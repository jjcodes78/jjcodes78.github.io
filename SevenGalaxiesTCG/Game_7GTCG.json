{
  "name": "SevenGalaxiesTCG",
  "deckBuilding": {
    "mainFilters": ["type", "cost"],
    "formats": [
      { "title": "Standard format", "gameplay": "Standard" }
    ]
  },
  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 5
      },
      "newTurn": {
        "drawPerTurn": 1
      },
      "countersStartingValues": [],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "isSymmetricalForOpponents": true,
              "style": {
                "gap": "6px",
                "alignItems": "stretch"
              },
              "content": [
                {
                  "direction": "column",
                  "style": {
                    "width": "15%"
                  },
                  "content": [
                    {
                      "section": "Deck"
                    },
                    {
                      "section": "ExtraDeck"
                    }
                  ]
                },
                {
                  "direction": "column",
                  "style": {
                    "width": "20%"
                  },
                  "content": [
                    {
                      "section": "Discard"
                    },
                    {
                      "section": "Defeated"
                    }
                  ]
                },
                {
                  "direction": "column",
                  "style": {
                    "width": "35%"
                  },
                  "content": [
                    {
                      "section": "EventSupport"
                    },
                    {
                      "section": "StrategySupport"
                    }
                  ]
                },
                {
                  "direction": "column",
                  "style": {
                    "width": "30%"
                  },
                  "content": [
                    {
                      "section": "Leader"
                    },
                    {
                      "section": "Fortress"
                    }
                  ]
                }
              ]
            },
            {
              "direction": "row",
              "isSymmetricalForOpponents": true,
              "style": {
                "gap": "6px",
                "marginTop": "6px"
              },
              "content": [
                {
                  "section": "Resources",
                  "style": {
                    "width": "22%"
                  }
                },
                {
                  "direction": "column",
                  "style": {
                    "width": "78%",
                    "gap": "4px"
                  },
                  "content": [
                    {
                      "direction": "row",
                      "style": {
                        "gap": "4px"
                      },
                      "content": [
                        {
                          "section": "A1"
                        },
                        {
                          "section": "A2"
                        },
                        {
                          "section": "A3"
                        },
                        {
                          "section": "A4"
                        }
                      ]
                    },
                    {
                      "direction": "row",
                      "style": {
                        "gap": "4px"
                      },
                      "content": [
                        {
                          "section": "D1"
                        },
                        {
                          "section": "D2"
                        },
                        {
                          "section": "D3"
                        },
                        {
                          "section": "D4"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "section": "Hand",
              "style": {
                "marginTop": "8px"
              }
            }
          ]
        },
        "sectionsDict": {
          "Hand": {
            "isHidden": "no",
            "height": 18,
            "alignment": "CENTER",
            "displayedTitle": "Mão"
          },
          "Deck": {
            "isHidden": "yes",
            "height": 16,
            "alignment": "DECK",
            "displayedTitle": "Deck"
          },
          "ExtraDeck": {
            "isHidden": "yes",
            "height": 16,
            "alignment": "DECK",
            "displayedTitle": "Deck Especial"
          },
          "Discard": {
            "isHidden": "no",
            "height": 16,
            "alignment": "DECK",
            "displayedTitle": "Descarte"
          },
          "Defeated": {
            "isHidden": "no",
            "height": 16,
            "alignment": "DECK",
            "displayedTitle": "Derrotados"
          },
          "EventSupport": {
            "isHidden": "no",
            "height": 18,
            "alignment": "START",
            "displayedTitle": "Evento / Estratégia / Suporte"
          },
          "StrategySupport": {
            "isHidden": "no",
            "height": 18,
            "alignment": "START",
            "displayedTitle": "Estratégia / Suporte"
          },
          "Leader": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "Líder de Batalha"
          },
          "Fortress": {
            "type": "custom",
            "defaultValue": {
              "life": 25,
              "intuition20": true,
              "intuition10": true,
              "intuition5": true
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "gap": "4px",
                  "padding": "8px",
                  "border": "1px solid #777",
                  "borderRadius": "6px"
                }
              },
              "children": [
                {
                  "type": "div",
                  "children": [
                    "Fortaleza"
                  ]
                },
                {
                  "type": "div",
                  "children": [
                    "Vida"
                  ]
                },
                {
                  "type": "input-number",
                  "props": {
                    "value": "{{ game.data.Fortress.life }}",
                    "min": 0
                  },
                  "onChange": "game.data.Fortress.life = value"
                },
                {
                  "type": "div",
                  "children": [
                    "Intuição"
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "gap": "8px",
                      "flexWrap": "wrap"
                    }
                  },
                  "children": [
                    {
                      "type": "label",
                      "children": [
                        {
                          "type": "input-checkbox",
                          "props": {
                            "checked": "{{ game.data.Fortress.intuition20 }}"
                          },
                          "onChange": "game.data.Fortress.intuition20 = value"
                        },
                        "20"
                      ]
                    },
                    {
                      "type": "label",
                      "children": [
                        {
                          "type": "input-checkbox",
                          "props": {
                            "checked": "{{ game.data.Fortress.intuition10 }}"
                          },
                          "onChange": "game.data.Fortress.intuition10 = value"
                        },
                        "10"
                      ]
                    },
                    {
                      "type": "label",
                      "children": [
                        {
                          "type": "input-checkbox",
                          "props": {
                            "checked": "{{ game.data.Fortress.intuition5 }}"
                          },
                          "onChange": "game.data.Fortress.intuition5 = value"
                        },
                        "5"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "Resources": {
            "type": "custom",
            "defaultValue": {
              "level": 0,
              "energy": 0
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "gap": "8px",
                  "padding": "8px",
                  "border": "1px solid #777",
                  "borderRadius": "6px"
                }
              },
              "children": [
                {
                  "type": "div",
                  "children": [
                    "Reservas"
                  ]
                },
                {
                  "type": "label",
                  "children": [
                    "Nível"
                  ]
                },
                {
                  "type": "input-number",
                  "props": {
                    "value": "{{ game.data.Resources.level }}",
                    "min": 0
                  },
                  "onChange": "game.data.Resources.level = value"
                },
                {
                  "type": "label",
                  "children": [
                    "Energia"
                  ]
                },
                {
                  "type": "input-number",
                  "props": {
                    "value": "{{ game.data.Resources.energy }}",
                    "min": 0
                  },
                  "onChange": "game.data.Resources.energy = value"
                }
              ]
            }
          },
          "A1": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "A1"
          },
          "A2": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "A2"
          },
          "A3": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "A3"
          },
          "A4": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "A4"
          },
          "D1": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "D1"
          },
          "D2": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "D2"
          },
          "D3": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "D3"
          },
          "D4": {
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "D4"
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://jjcodes78.github.io/SevenGalaxiesTCG/Game_Cards.json",
    "cardBack": "https://example.com/card-back.jpg"
  }
}